# DaSSO Test - Monorepo Configuration

# Keycloak Configuration (Railway)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
KC_DB_USERNAME=postgres.<PROJECT_REF>
KC_DB_PASSWORD=<SUPABASE_PASSWORD>
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Backend Gateway Configuration (Railway)
PORT=4000
KEYCLOAK_URL=https://<RAILWAY_KEYCLOAK_URL>

# Frontend Mock Web Configuration (Vercel)
NEXT_PUBLIC_KEYCLOAK_URL=https://<RAILWAY_KEYCLOAK_URL>
NEXT_PUBLIC_SERVER_URL=https://<RAILWAY_SERVER_URL>

